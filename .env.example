# Copiá este archivo como .env.local y completá los valores.

# URL base del backend (sin /api/v1). Si se deja vacía, la app usa los
# datos simulados de src/mocks (modo demo).
API_URL=

# Secreto para firmar la cookie de sesión. Obligatorio en producción.
# Generalo con: openssl rand -base64 32
SESSION_SECRET=
